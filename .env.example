# Kalcifer Environment Variables
# Copy this file to .env and fill in the values

# =====================================================
# Required
# =====================================================

# Database connection (PostgreSQL 16+)
DATABASE_URL=ecto://postgres:postgres@localhost/kalcifer_dev

# Secret key for session encryption (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# Hostname for URL generation
PHX_HOST=localhost

# =====================================================
# Optional — Server
# =====================================================

# Port (default: 4500)
# PORT=4500

# Database pool size (default: 20)
# DATABASE_POOL_SIZE=20

# Enable IPv6 for Fly.io
# ECTO_IPV6=true

# DNS cluster query for Fly.io BEAM clustering
# DNS_CLUSTER_QUERY=kalcifer.internal

# =====================================================
# Optional — Channel Providers
# =====================================================

# SendGrid (Email)
# SENDGRID_API_KEY=SG.xxx

# Twilio (SMS)
# TWILIO_ACCOUNT_SID=xxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_FROM_NUMBER=+1234567890

# =====================================================
# Optional — AI Features (Cloud / BYOK)
# =====================================================

# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API
# OPENAI_API_KEY=sk-xxx

# Google Gemini API
# GEMINI_API_KEY=xxx

# =====================================================
# Optional — Billing (Cloud only)
# =====================================================

# Stripe
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
