# Kalcifer Environment Variables
# Copy this file to .env and fill in the values

# =====================================================
# Required
# =====================================================

# Database connection (PostgreSQL 16+)
DATABASE_URL=ecto://postgres:postgres@localhost/kalcifer_dev

# Secret key for session encryption (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# Hostname for URL generation
PHX_HOST=localhost

# Session token signing secret for Google OAuth logins
# (generate with: mix phx.gen.secret)
AUTH_SESSION_SECRET=

# =====================================================
# Optional — Server
# =====================================================

# Port (default: 4500)
# PORT=4500

# Dev only: bind 0.0.0.0 instead of :: — needed on machines without IPv6,
# where the default binding fails at boot with :eafnosupport
# BIND_IP=ipv4

# Set to any value to force the HTTP server on in releases
# PHX_SERVER=true

# Database pool size (default: 20)
# DATABASE_POOL_SIZE=20

# Enable IPv6 for Fly.io
# ECTO_IPV6=true

# DNS cluster query for Fly.io BEAM clustering
# DNS_CLUSTER_QUERY=kalcifer.internal

# =====================================================
# Optional — Channel Providers
# =====================================================

# SendGrid (Email)
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=no-reply@example.com
# SENDGRID_FROM_NAME=Kalcifer
# SENDGRID_WEBHOOK_VERIFICATION_KEY=base64-public-key-from-sendgrid

# Twilio (SMS + WhatsApp)
# TWILIO_ACCOUNT_SID=xxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_FROM_NUMBER=+1234567890
# TWILIO_WHATSAPP_FROM=+1234567890

# =====================================================
# Optional — AI Features (Cloud / BYOK)
# =====================================================

# Anthropic Claude API
# ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API
# OPENAI_API_KEY=sk-xxx

# Google Gemini API
# GEMINI_API_KEY=xxx

# =====================================================
# Optional — Billing (Cloud only)
# =====================================================

# Stripe
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
